{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/usr/share/lyra-os-theme/fastfetch/euri.png",
    "width": 30,
    "height": 14,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "command",
      "key": "OS",
      "text": "if [ -r /etc/os-release ]; then . /etc/os-release; name=${NAME:-${PRETTY_NAME:-Linux}}; version=${VERSION_ID:-${VERSION:-}}; printf '%s' \"$name\"; [ -n \"$version\" ] && printf ' %s' \"$version\"; printf '\\n'; else printf '%s\\n' 'Unknown'; fi"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "colors"
  ]
}
